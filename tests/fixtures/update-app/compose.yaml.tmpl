# idea#76 update-test fixture App (Playwright updateApp on idea04). Rendered per version by
# script/build-update-fixtures.sh; @VERSION@ / @UPDATES_FROM@ / @NOTE@ are filled in there.
x-app:
  name: updtest
  title: Update Test
  description: Tiny busybox httpd that shows its App version. Test fixture for idea#76 only.
  url: https://github.com/koenswings/agent-app-dev
  category: test
  author: IDEA
  version: "@VERSION@"
  instanceName: updtest
  healthCheck:
    path: /
    expect: "updtest @VERSION@"
  healthTimeout: 60
  updatesFrom: @UPDATES_FROM@
  migrationNote: "@NOTE@"
  snapshotExclude: []

services:
  web:
    image: busybox:1.36.1@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
    restart: no
    pull_policy: never
    labels:
      x-app-version: "@VERSION@"
    # Page shows the version; data/visits.log persists across updates (./data bind mount).
    command: ["/bin/sh", "-c", "mkdir -p /data /www && echo 'updtest @VERSION@' > /www/index.html && date >> /data/visits.log && exec httpd -f -p 8080 -h /www"]
    volumes:
      - ./data:/data
    ports:
      - ${port}:8080
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
